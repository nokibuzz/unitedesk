# Local API port. The web development server proxies /api to this port.
PORT=3001
HOST=127.0.0.1

# Select one ticketing provider. JIRA_MODE remains a legacy fallback.
TICKETING_PROVIDER=mock
# Start with local JSON data: npm run mock:seed
JIRA_MODE=mock

# For a local read-only connection, use JIRA_MODE=jira and fill these in.
# Keep .env private. Do not expose the API on a public interface before auth is added.
# JIRA_URL is optional when JIRA_BOARD_URL includes the full Jira origin.
JIRA_URL=
JIRA_BOARD_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional if the board cannot be resolved from JIRA_BOARD_URL:
JIRA_BOARD_ID=
# Optional Jira estimate field override:
JIRA_STORY_POINTS_FIELD=
# Team workflow defaults; Settings → Team can override these values locally.
JIRA_TEST_TASK_NAME=Test the solution

# Linear active cycle adapter. Create a read-only personal API key for local testing.
# The team identifier is visible in Linear issue keys, for example DEMO-1 -> DEMO.
LINEAR_TEAM=
LINEAR_API_KEY=

# Daily recap starts at this hour on the previous day in the selected time zone.
# Use an IANA zone such as Europe/Belgrade, America/New_York, or UTC.
DAILY_TIME_ZONE=UTC
DAILY_CUTOFF_HOUR=10
# Seconds per ticket (15-900):
DAILY_TICKET_SECONDS=180

# Select one code review provider. GITLAB_MODE remains a legacy fallback.
CODE_REVIEW_PROVIDER=mock
# Read-only GitLab group merge request view. Run npm run mock:seed for local data.
GITLAB_MODE=mock
GITLAB_URL=
GITLAB_GROUP=
GITLAB_TOKEN=
# Calendar days before an MR is marked as aging; cached live data in milliseconds.
GITLAB_STALE_DAYS=2
GITLAB_CACHE_TTL_MS=30000

# GitHub pull request adapter. Owner defaults to the authenticated user if blank.
# Leave GITHUB_REPOS blank to scan accessible repositories owned by GITHUB_OWNER.
GITHUB_API_URL=https://api.github.com
GITHUB_OWNER=
GITHUB_REPOS=
GITHUB_TOKEN=

# Knowledge tab: choose one or more adapters, for example confluence,github,notion.
# DOCUMENTATION_PROVIDER remains a single-provider fallback when this is blank.
DOCUMENTATION_PROVIDERS=confluence
DOCUMENTATION_PROVIDER=
# Confluence documents API. Personal spaces are excluded unless listed explicitly.
CONFLUENCE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_KEYS=
# Optional indexed term from a synthetic page; npm run test:live also checks search when set.
CONFLUENCE_TEST_QUERY=

# GitHub Markdown: explicitly select repositories and paths. Defaults to docs/ and README.md.
# Uses the server-side GITHUB_TOKEN above. Limit: 100 selected Markdown files total.
GITHUB_DOCS_REPOS=
GITHUB_DOCS_PATHS=docs/,README.md
GITHUB_DOCS_TEST_QUERY=

# Notion: use a local personal access token or integration token. Share desired pages
# with an internal integration; a personal access token uses your own access.
# Up to 100 accessible pages are indexed for title and body search in this version.
NOTION_API_KEY=
NOTION_API_VERSION=2026-03-11
NOTION_TEST_QUERY=
# Local-only sample pages generated by npm run mock:seed:notion. No token needed.
NOTION_MODE=
