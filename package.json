{
  "name": "unitedesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @unitedesk/web",
    "dev:api": "npm run dev --workspace @unitedesk/api",
    "build": "npm run build --workspace @unitedesk/web && npm run build --workspace @unitedesk/api",
    "build:demo": "npm run build:demo --workspace @unitedesk/web",
    "typecheck": "npm run typecheck --workspace @unitedesk/web && npm run typecheck --workspace @unitedesk/api",
    "start": "npm run start --workspace @unitedesk/api",
    "mock:seed": "npm run mock:seed:jira && npm run mock:seed:gitlab && npm run mock:seed:notion",
    "mock:seed:jira": "node scripts/seed-mock.mjs",
    "mock:seed:gitlab": "node scripts/seed-gitlab-mock.mjs",
    "mock:seed:notion": "node scripts/seed-notion-mock.mjs",
    "test:history": "node --import tsx --test apps/api/src/sprint/history.test.ts",
    "test:daily": "node --import tsx --test apps/api/src/sprint/daily.test.ts",
    "test:reviews": "node --import tsx --test apps/api/src/merge-requests/service.test.ts apps/web/tests/review-filter.test.ts",
    "test:settings": "node --import tsx --test apps/api/src/settings/team.test.ts",
    "test:linear": "node --import tsx --test apps/api/src/sprint/linear.test.ts",
    "test:github": "node --import tsx --test apps/api/src/merge-requests/github.test.ts",
    "test:confluence": "node --import tsx --test apps/api/src/documents/confluence.test.ts",
    "test:github-docs": "node --import tsx --test apps/api/src/documents/github.test.ts",
    "test:notion-docs": "node --import tsx --test apps/api/src/documents/notion.test.ts",
    "test:documents": "node --import tsx --test apps/api/src/documents/service.test.ts",
    "test:links": "node --import tsx --test apps/api/src/useful-links/service.test.ts apps/web/tests/useful-links-search.test.ts",
    "test:review-config": "node --import tsx --test apps/api/src/settings/code-review.test.ts",
    "test:demo": "node --import tsx --test apps/web/tests/demo.test.ts",
    "test:poker": "node --import tsx --test apps/api/src/poker/rooms.test.ts apps/api/src/poker/tickets.test.ts",
    "test:live": "npm run build && node scripts/test-live-integrations.mjs",
    "test": "npm run test:history && npm run test:daily && npm run test:reviews && npm run test:settings && npm run test:review-config && npm run test:linear && npm run test:github && npm run test:confluence && npm run test:github-docs && npm run test:notion-docs && npm run test:documents && npm run test:links && npm run test:poker && npm run test:demo"
  }
}
